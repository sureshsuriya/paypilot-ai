# =============================================================================
# PayPilot AI — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# IMPORTANT: The frontend ONLY communicates with the Spring Boot backend.
# All AI requests are proxied through /api/ai/* in the backend.
# The Node.js AI service (port 3001) is NEVER exposed to the browser.
# No Gemini keys, AI secrets, or PayPal secrets belong here.
# =============================================================================

# ----- Spring Boot Backend URL -----
VITE_API_BASE_URL=http://localhost:8080/api

# ----- App Environment -----
VITE_APP_ENV=development

