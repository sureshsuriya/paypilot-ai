{
  "name": "paypilot-ai-service",
  "version": "1.0.0",
  "description": "PayPilot AI — Node.js AI orchestration service (Google Gemini). Internal only — not exposed to browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
