# =============================================================================
# PayPilot AI — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# ----- PayPal Sandbox (required) -----
# Get these from https://developer.paypal.com > My Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: reserved webhook ID property
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# ----- JWT (required) -----
# Generate a secure random string of at least 32 characters (e.g. openssl rand -base64 32)
# JWT_EXPIRATION_MS expects milliseconds (e.g. 86400000 for 24h)
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION_MS=86400000

# ----- MySQL 8.0.45 (required) -----
# Example: jdbc:mysql://localhost:3306/paypilot_ai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_URL=your_mysql_database_url
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password

# ----- AI Service (internal — not exposed to browser) -----
AI_SERVICE_URL=http://localhost:3001
# Shared secret matching AI_SERVICE_SECRET in ai-service/.env
AI_SERVICE_SECRET=your_ai_service_secret
GEMINI_MODEL=gemini-3.5-flash-lite

# ----- Server & CORS -----
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----- Email / SMTP Delivery (optional) -----
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@paypilot.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_RESEND_COOLDOWN_SECONDS=60
