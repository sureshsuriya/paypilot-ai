# =============================================================================
# PayPilot AI — .gitignore
# IMPORTANT: Never commit credentials, secrets, or API keys.
# =============================================================================

# ----- Environment files (NEVER commit real .env files) -----
.env
.env.local
.env.production
.env.staging
*.env
!.env.example

# ----- Node.js / npm / pnpm -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-store/

# ----- TypeScript build output -----
dist/
build/
out/
*.js.map
*.d.ts.map

# ----- Java / Maven -----
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
hs_err_pid*
replay_pid*

# ----- Spring Boot -----
spring-shell.log

# ----- IDE and editor files -----
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ----- Frontend build artifacts -----
frontend/dist/
frontend/build/
frontend/.vite/

# ----- Uploaded files (invoices, PDFs) — store in cloud/local only -----
uploads/
*.pdf
*.PDF

# ----- Logs -----
logs/
*.log
npm-debug.log*
lerna-debug.log*

# ----- Test coverage -----
coverage/
*.lcov
.nyc_output/

# ----- Docker -----
.docker/

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ----- Misc -----
*.tmp
*.temp
.cache/

