# =============================================================================
# PayPilot AI — AI Service Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# This service is INTERNAL ONLY. It is called by the Spring Boot backend.
# It is never exposed directly to the browser.
# =============================================================================

# ----- OpenAI (required for live AI features) -----
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# ----- Demo Mode -----
# Set to true to run without an OpenAI API key.
# All AI features return realistic pre-built responses.
# Human approval gates, audit logging, and UI labels work identically.
DEMO_MODE=false

# ----- Service Configuration -----
AI_SERVICE_PORT=3001

# ----- Backend URL (Spring Boot) -----
BACKEND_URL=http://localhost:8080

# ----- Shared Secret -----
# Must match AI_SERVICE_SECRET in backend/.env
# Spring Boot sends this header; AI service validates it.
AI_SERVICE_SECRET=replace_with_shared_secret_here

