# =============================================================================
# PayPilot AI — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# ----- PayPal Sandbox (required) -----
# Get these from https://developer.paypal.com > My Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: Set after configuring a webhook in the PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID=

# ----- JWT (required) -----
# Generate a secure random string of at least 32 characters
# Example: openssl rand -base64 32
JWT_SECRET=replace_with_minimum_32_character_secret_here
JWT_EXPIRATION_MS=86400000

# ----- MySQL 8.0.45 (required) -----
# Database name: paypilot_ai (do NOT change — existing DB)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/paypilot_ai?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=paypilot_user
SPRING_DATASOURCE_PASSWORD=your_db_password_here

# ----- AI Service (internal — not exposed to browser) -----
AI_SERVICE_URL=http://localhost:3001
# Shared secret so Spring Boot can authenticate requests to the AI service
AI_SERVICE_SECRET=replace_with_shared_secret_here

# ----- Server -----
SERVER_PORT=8080

# ----- Email / SMTP Delivery (optional) -----
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@paypilot.local
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

